--------------------------------------------------------------------------------
-- UI UTILITY HELPERS
--------------------------------------------------------------------------------
local function ApplyCorner(parent, px)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, px or 8)
	c.Parent = parent
	return c
end

local function ApplyStroke(parent, col, thick)
	local s = Instance.new("UIStroke")
	s.Color = col or Color3.fromRGB(45, 45, 45)
	s.Thickness = thick or 1
	s.Parent = parent
	return s
end

