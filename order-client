local ActiveTrackedOrder = nil

-- Fixed: Properly re-binds on player respawn so tracker doesn't break
local function VerifyInventoryCompletion()
	if not ActiveTrackedOrder then return end
	local allDone = true
	for _, item in ipairs(ActiveTrackedOrder.Items) do
		local hasInBackpack = LocalPlayer:FindFirstChild("Backpack") and LocalPlayer.Backpack:FindFirstChild(item.Name)
		local hasInChar = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild(item.Name)

		if not hasInBackpack and not hasInChar then
			allDone = false
			break
		end
	end

	if allDone then
		FinishOrderBtn.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
		FinishOrderBtn.TextColor3 = Color3.fromRGB(90, 255, 140)
	else
		FinishOrderBtn.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
		FinishOrderBtn.TextColor3 = Color3.fromRGB(100, 100, 100)
	end
end

local backpackConAdded, backpackConRemoved
local function BindBackpackEvents()
	if backpackConAdded then backpackConAdded:Disconnect() end
	if backpackConRemoved then backpackConRemoved:Disconnect() end
	local backpack = LocalPlayer:WaitForChild("Backpack", 5)
	if backpack then
		backpackConAdded = backpack.ChildAdded:Connect(VerifyInventoryCompletion)
		backpackConRemoved = backpack.ChildRemoved:Connect(VerifyInventoryCompletion)
	end
	VerifyInventoryCompletion()
end
LocalPlayer.CharacterAdded:Connect(BindBackpackEvents)
if LocalPlayer.Character then BindBackpackEvents() end


-- Navigation State & Setup
local activeBeam = nil
local activeAttachment0 = nil
local activeAttachment1 = nil
local checkConnection = nil 

local function clearNavigation()
	if checkConnection then
		checkConnection:Disconnect()
		checkConnection = nil
	end
	if activeBeam then
		activeBeam:Destroy()
		activeBeam = nil
	end
	if activeAttachment0 then
		activeAttachment0:Destroy()
		activeAttachment0 = nil
	end
	if activeAttachment1 then
		activeAttachment1:Destroy()
		activeAttachment1 = nil
	end
end

local function drawNavigationBeam(targetPart)
	clearNavigation()
	local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
	local rootPart = character:WaitForChild("HumanoidRootPart", 5)

	if not rootPart or not targetPart then return end

	activeAttachment0 = Instance.new("Attachment")
	activeAttachment0.Name = "NavAttachmentPlayer"
	activeAttachment0.Parent = rootPart

	activeAttachment1 = Instance.new("Attachment")
	activeAttachment1.Name = "NavAttachmentTarget"
	activeAttachment1.Parent = targetPart

	activeBeam = Instance.new("Beam")
	activeBeam.Name = "OrderNavigationBeam"
	activeBeam.Attachment0 = activeAttachment0
	activeBeam.Attachment1 = activeAttachment1
	activeBeam.FaceCamera = true
	activeBeam.Width0 = 1.2
	activeBeam.Width1 = 1.2
	activeBeam.Color = ColorSequence.new(Color3.fromRGB(255, 204, 102))
	activeBeam.Texture = "rbxassetid://446111271"
	activeBeam.TextureSpeed = 2 
	activeBeam.TextureLength = 4
	activeBeam.LightEmission = 0.8
	activeBeam.LightInfluence = 0
	activeBeam.Parent = character

	checkConnection = RunService.Heartbeat:Connect(function()
		if not rootPart or not rootPart.Parent or not targetPart or not targetPart.Parent then
			clearNavigation()
			return
		end

		local distance = (rootPart.Position - targetPart.Position).Magnitude
		if distance <= 6 then
			clearNavigation()
		end
	end)
end

