local function RenderBasket()
	for _, child in ipairs(BasketScroll:GetChildren()) do
		if child:IsA("Frame") then child:Destroy() end
	end
	for idx, item in ipairs(CurrentOrderBasket) do
		local card = Instance.new("Frame")
		card.Size = UDim2.new(1, 0, 0, 32)
		card.BackgroundColor3 = Color3.fromRGB(22, 22, 22)
		card.Parent = BasketScroll
		ApplyCorner(card, 6)

		local txt = Instance.new("TextLabel")
		txt.Size = UDim2.new(1, -30, 1, 0)
		txt.Position = UDim2.new(0, 8, 0, 0)
		txt.BackgroundTransparency = 1
		txt.Font = Enum.Font.Gotham
		txt.Text = item.Name .. " (" .. item.Type .. " - " .. item.Temp .. ")"
		txt.TextColor3 = Color3.fromRGB(200, 200, 200)
		txt.TextSize = 10
		txt.TextXAlignment = Enum.TextXAlignment.Left
		txt.Parent = card

		local removeBtn = Instance.new("TextButton")
		removeBtn.Size = UDim2.new(0, 20, 0, 20)
		removeBtn.Position = UDim2.new(1, -24, 0.5, -10)
		removeBtn.BackgroundTransparency = 1
		removeBtn.Font = Enum.Font.GothamBold
		removeBtn.Text = "✕"
		removeBtn.TextColor3 = Color3.fromRGB(255, 90, 90)
		removeBtn.TextSize = 11
		removeBtn.Parent = card
		removeBtn.MouseButton1Click:Connect(function()
			table.remove(CurrentOrderBasket, idx)
			RenderBasket()
		end)
	end 
	SubmitBtn.Text = string.format("SUBMIT ORDER (%d/5)", #CurrentOrderBasket)
end

local function OpenCustomizer(itemName, itemInfo)
	SelectedItemData = { Name = itemName, Info = itemInfo }
	SelectedTypeChoice = itemInfo.Types[1] or "Standard"
	SelectedTempChoice = itemInfo.Temperatures[1] or "Standard"
	ModalTitle.Text = "Options: " .. itemName
	CustomModal.Visible = true

	local function RenderTypeButtons()
		for _, v in ipairs(TypeContainer:GetChildren()) do 
			if v:IsA("TextButton") then v:Destroy() end 
		end
		for _, tName in ipairs(itemInfo.Types) do
			local btn = Instance.new("TextButton")
			btn.BackgroundColor3 = (tName == SelectedTypeChoice) and Color3.fromRGB(70, 70, 70) or Color3.fromRGB(22, 22, 22)
			btn.Font = Enum.Font.Gotham
			btn.Text = tName
			btn.TextColor3 = Color3.fromRGB(220, 220, 220)
			btn.TextSize = 10
			btn.ZIndex = 12
			btn.Parent = TypeContainer
			ApplyCorner(btn, 4)
			btn.MouseButton1Click:Connect(function()
				SelectedTypeChoice = tName
				RenderTypeButtons()
			end)
		end
	end

	local function RenderTempButtons()
		for _, v in ipairs(TempContainer:GetChildren()) do 
			if v:IsA("TextButton") then v:Destroy() end 
		end
		for _, tempName in ipairs(itemInfo.Temperatures) do
			local btn = Instance.new("TextButton")
			btn.BackgroundColor3 = (tempName == SelectedTempChoice) and Color3.fromRGB(70, 70, 70) or Color3.fromRGB(22, 22, 22)
			btn.Font = Enum.Font.Gotham
			btn.Text = tempName
			btn.TextColor3 = Color3.fromRGB(220, 220, 220)
			btn.TextSize = 10
			btn.ZIndex = 12
			btn.Parent = TempContainer
			ApplyCorner(btn, 4) 
			btn.MouseButton1Click:Connect(function()
				SelectedTempChoice = tempName
				RenderTempButtons()
			end)
		end
	end
	RenderTypeButtons()
	RenderTempButtons()
end

AddToBasketBtn.MouseButton1Click:Connect(function()
	if #CurrentOrderBasket >= 5 then
		CreateNotification("Order Max", "Basket maximum reached (5 items)!")
		CustomModal.Visible = false
		return
	end
	table.insert(CurrentOrderBasket, {
		Name = SelectedItemData.Name,
		Type = SelectedTypeChoice,
		Temp = SelectedTempChoice
	})
	CustomModal.Visible = false
	RenderBasket()
end)

local function PopulateMenuCategory(catName)
	for _, child in ipairs(ItemsScroll:GetChildren()) do
		if child:IsA("TextButton") then child:Destroy() end
	end
	for itemName, itemInfo in pairs(MenuData.Items) do
		if itemInfo.Category == catName then
			local btn = Instance.new("TextButton")
			btn.BackgroundColor3 = Color3.fromRGB(18, 18, 18)
			btn.Font = Enum.Font.GothamBold
			btn.Text = itemName
			btn.TextColor3 = Color3.fromRGB(220, 220, 220)
			btn.TextSize = 11
			btn.Parent = ItemsScroll
			ApplyCorner(btn, 8)
			ApplyStroke(btn, Color3.fromRGB(30, 30, 30), 1)
			btn.MouseButton1Click:Connect(function()
				OpenCustomizer(itemName, itemInfo)
			end)
		end
	end
end 

local function InitMenuCategories()
	for _, child in ipairs(CatBar:GetChildren()) do
		if child:IsA("TextButton") then child:Destroy() end
	end
	for idx, catName in ipairs(MenuData.Categories) do
		local btn = Instance.new("TextButton")
		btn.Size = UDim2.new(0, 90, 1, 0)
		btn.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
		btn.Font = Enum.Font.GothamBold
		btn.Text = catName
		btn.TextColor3 = Color3.fromRGB(200, 200, 200)
		btn.TextSize = 10
		btn.Parent = CatBar
		ApplyCorner(btn, 6)
		btn.MouseButton1Click:Connect(function()
			PopulateMenuCategory(catName)
		end)
		if idx == 1 then PopulateMenuCategory(catName) end
	end
end

local function RefreshCustomerList(filter)
	for _, v in ipairs(CustScroll:GetChildren()) do
		if v:IsA("Frame") then v:Destroy() end
	end
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= LocalPlayer then
			if not filter or filter == "" or string.find(p.Name:lower(), filter:lower()) or string.find(p.DisplayName:lower(), filter:lower()) then
				local card = Instance.new("Frame")
				card.BackgroundColor3 = Color3.fromRGB(18, 18, 18)
				card.Parent = CustScroll
				ApplyCorner(card, 8)

				local nameLbl = Instance.new("TextLabel")
				nameLbl.Size = UDim2.new(1, -20, 1, 0)
				nameLbl.Position = UDim2.new(0, 10, 0, 0)
				nameLbl.BackgroundTransparency = 1
				nameLbl.Font = Enum.Font.GothamBold
				nameLbl.Text = p.DisplayName .. "\n(@" .. p.Name .. ")"
				nameLbl.TextColor3 = Color3.fromRGB(220, 220, 220)
				nameLbl.TextSize = 11
				nameLbl.TextXAlignment = Enum.TextXAlignment.Left
				nameLbl.Parent = card

				local selBtn = Instance.new("TextButton") 
				selBtn.Size = UDim2.new(1, 0, 1, 0)
				selBtn.BackgroundTransparency = 1
				selBtn.Text = ""
				selBtn.Parent = card
				selBtn.MouseButton1Click:Connect(function()
					SelectedCustomerPlayer = p
					SelectedCustLabel.Text = "Customer: " .. p.DisplayName
					CustomerSelectPanel.Visible = false
					OrderMainPanel.Visible = true
					InitMenuCategories()
				end)
			end
		end
	end
end

CustSearch.Changed:Connect(function(prop)
	if prop == "Text" then RefreshCustomerList(CustSearch.Text) end
end)

UnclaimBtn.MouseButton1Click:Connect(function()
	RegisterActionRemote:FireServer("Unclaim")
	PosFrame.Visible = false
end)

SubmitBtn.MouseButton1Click:Connect(function()
	if not SelectedCustomerPlayer then return end
	if #CurrentOrderBasket == 0 then
		CreateNotification("Order Empty", "Add an item to basket first!")
		return
	end
	SubmitOrderRemote:FireServer(SelectedCustomerPlayer, CurrentOrderBasket)
	PosFrame.Visible = false
	CurrentOrderBasket = {}
	RenderBasket()
end)

RegisterActionRemote.OnClientEvent:Connect(function(action, data)
	if action == "OpenPOS" then
		PosFrame.Visible = true
		CustomerSelectPanel.Visible = true
		OrderMainPanel.Visible = false
		CustomModal.Visible = false
		RefreshCustomerList("")
	elseif action == "ForceClosePOS" then
		PosFrame.Visible = false 
	end
end)

